<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MUGEB Bebras CT Adventure - SD Muhammadiyah GKB Gresik</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --mugeb-teal: #006778;
            --mugeb-orange: #EA7600;
            --mugeb-dark: #2B2B2B;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top right, #e0f2fe, #f0fdf4, #fff7ed);
            min-height: 100vh;
            overflow-x: hidden;
        }
        .font-game {
            font-family: 'Fredoka', sans-serif;
        }
        .btn-3d {
            transition: all 0.15s ease;
            box-shadow: 0 6px 0 rgba(0,0,0,0.2);
        }
        .btn-3d:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 rgba(0,0,0,0.2);
        }
        .btn-teal {
            background: linear-gradient(135deg, #007d91, #005968);
            box-shadow: 0 6px 0 #003d47;
        }
        .btn-teal:active {
            box-shadow: 0 2px 0 #003d47;
        }
        .btn-orange {
            background: linear-gradient(135deg, #ff8c1a, #e66b00);
            box-shadow: 0 6px 0 #b35300;
        }
        .btn-orange:active {
            box-shadow: 0 2px 0 #b35300;
        }
        .option-card {
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .option-card:hover:not(:disabled) {
            transform: translateY(-3px) scale(1.01);
        }
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: float 3.5s ease-in-out infinite;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
    </style>
</head>
<body class="text-slate-800 flex flex-col min-h-screen">

    <!-- Top Navigation Bar with MUGEB Logo -->
    <header class="bg-white/90 backdrop-blur-md border-b-2 border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-6xl mx-auto px-4 py-2.5 flex flex-wrap justify-between items-center gap-3">
            <!-- Recreated Official MUGEB Primary School Logo -->
            <div class="flex items-center gap-3 cursor-pointer" onclick="confirmReturnHome()">
                <div class="bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-center">
                    <div class="flex items-baseline gap-1.5 leading-none">
                        <span class="font-extrabold text-2xl sm:text-3xl tracking-tight" style="color: #006778; font-family: 'Plus Jakarta Sans', sans-serif;">MUGEB</span>
                        <span class="font-bold italic text-base sm:text-xl" style="color: #EA7600; font-family: 'Plus Jakarta Sans', sans-serif;">Primary School</span>
                    </div>
                    <span class="font-bold text-[10px] sm:text-xs tracking-wider mt-0.5" style="color: #2B2B2B;">SD Muhammadiyah GKB Gresik</span>
                </div>
            </div>

            <!-- Right Controls & Live Stats -->
            <div class="flex items-center gap-2 sm:gap-4">
                <div id="liveStats" class="hidden items-center gap-2 sm:gap-3 bg-slate-100 px-3 py-1.5 rounded-2xl border border-slate-200">
                    <div class="flex items-center gap-1.5 text-amber-600 font-game font-semibold text-sm sm:text-base">
                        <i class="fa-solid fa-star text-amber-400"></i>
                        <span id="headerScore">0</span>
                    </div>
                    <div class="h-4 w-[1px] bg-slate-300"></div>
                    <div class="flex items-center gap-1.5 text-teal-700 font-game font-semibold text-sm sm:text-base">
                        <i class="fa-solid fa-fire text-orange-500"></i>
                        <span id="headerStreak">0</span>
                    </div>
                </div>

                <button id="soundToggleBtn" onclick="toggleSound()" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition border border-slate-200" title="Suara Efek">
                    <i id="soundIcon" class="fa-solid fa-volume-high text-teal-700"></i>
                </button>
                <button onclick="openQuestionMap()" id="mapBtn" class="hidden px-3 py-2 rounded-xl bg-teal-50 hover:bg-teal-100 text-teal-800 font-semibold text-xs sm:text-sm items-center gap-1.5 border border-teal-200 transition">
                    <i class="fa-solid fa-table-cells"></i>
                    <span class="hidden sm:inline">Peta Soal</span>
                </button>
                <button onclick="openLeaderboardModal()" class="px-3 py-2 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 font-semibold text-xs sm:text-sm flex items-center gap-1.5 border border-amber-200 transition" title="Rekap Skor & Spreadsheet">
                    <i class="fa-solid fa-table-list text-amber-600"></i>
                    <span class="hidden md:inline">Rekap Nilai</span>
                </button>
                <button onclick="openTeacherModal()" class="w-10 h-10 rounded-xl bg-teal-50 hover:bg-teal-100 text-teal-800 flex items-center justify-center transition border border-teal-200" title="Pengaturan Spreadsheet & GitHub (Guru)">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-5xl w-full mx-auto px-4 py-6 flex flex-col justify-center">

        <!-- ================= SCREEN 1: START / HOME SCREEN ================= -->
        <section id="startScreen" class="bg-white rounded-3xl shadow-xl border-2 border-teal-100 overflow-hidden">
            <div class="bg-gradient-to-r from-[#006778] via-[#008399] to-[#006778] p-6 sm:p-10 text-white relative overflow-hidden">
                <!-- Decorative background shapes -->
                <div class="absolute -right-10 -top-10 w-44 h-44 bg-white/10 rounded-full blur-xl"></div>
                <div class="absolute left-10 -bottom-12 w-36 h-36 bg-amber-400/20 rounded-full blur-lg"></div>

                <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
                    <!-- Mascot Beaver SVG -->
                    <div class="w-28 h-28 sm:w-36 sm:h-36 bg-white rounded-3xl p-3 shadow-lg border-4 border-amber-400 animate-float flex-shrink-0 flex items-center justify-center">
                        <svg viewBox="0 0 120 120" class="w-full h-full">
                            <!-- Beaver Ears -->
                            <circle cx="30" cy="30" r="12" fill="#8B5A2B"/>
                            <circle cx="30" cy="30" r="6" fill="#D2B48C"/>
                            <circle cx="90" cy="30" r="12" fill="#8B5A2B"/>
                            <circle cx="90" cy="30" r="6" fill="#D2B48C"/>
                            <!-- Head -->
                            <ellipse cx="60" cy="60" rx="40" ry="36" fill="#A0522D"/>
                            <!-- Graduation / Explorer Hat -->
                            <path d="M25 32 Q60 15 95 32 L85 20 Q60 10 35 20 Z" fill="#006778"/>
                            <rect x="45" y="14" width="30" height="8" rx="4" fill="#EA7600"/>
                            <!-- Cheeks -->
                            <ellipse cx="45" cy="68" rx="14" ry="11" fill="#DEB887"/>
                            <ellipse cx="75" cy="68" rx="14" ry="11" fill="#DEB887"/>
                            <!-- Eyes -->
                            <circle cx="44" cy="50" r="5" fill="#1e293b"/>
                            <circle cx="42" cy="48" r="2" fill="#ffffff"/>
                            <circle cx="76" cy="50" r="5" fill="#1e293b"/>
                            <circle cx="74" cy="48" r="2" fill="#ffffff"/>
                            <!-- Nose -->
                            <ellipse cx="60" cy="60" rx="8" ry="5" fill="#3e2723"/>
                            <!-- Beaver Teeth -->
                            <rect x="53" y="72" width="6" height="10" rx="1.5" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
                            <rect x="61" y="72" width="6" height="10" rx="1.5" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
                        </svg>
                    </div>

                    <div class="text-center md:text-left">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400 text-slate-900 font-bold text-xs uppercase tracking-wider mb-3 shadow-sm">
                            <i class="fa-solid fa-bolt"></i> Tantangan Bebras Siaga SD/MI
                        </div>
                        <h1 class="font-game text-3xl sm:text-5xl font-bold tracking-wide leading-tight">
                            MUGEB Bebras <span class="text-amber-300">CT Adventure</span>
                        </h1>
                        <p class="text-teal-50 mt-2 text-sm sm:text-base max-w-2xl">
                            Asah kemampuan <strong>Computational Thinking</strong> (Dekomposisi, Pengenalan Pola, Abstraksi, & Algoritma) lewat 25 tantangan seru berbasis Buku Bebras Indonesia!
                        </p>
                    </div>
                </div>
            </div>

            <!-- Player Setup & Mode Selection -->
            <div class="p-6 sm:p-8 space-y-6">
                <!-- School Brand Banner inside Card -->
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-teal-600 text-white flex items-center justify-center font-bold text-lg">
                            <i class="fa-solid fa-school"></i>
                        </div>
                        <div>
                            <h2 class="font-bold text-slate-800 text-sm sm:text-base">MUGEB Primary School — SD Muhammadiyah GKB Gresik</h2>
                            <p class="text-xs text-slate-500">Program Penguatan Berpikir Komputasional & Literasi Digital</p>
                        </div>
                    </div>
                    <span class="px-3 py-1 rounded-lg bg-orange-100 text-orange-800 font-bold text-xs">
                        Total: 25 Soal & Pembahasan
                    </span>
                </div>

                <!-- Input Player Info -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                            <i class="fa-solid fa-user-astronaut text-teal-600 mr-1"></i> Nama Lengkap Siswa
                        </label>
                        <input id="playerNameInput" type="text" placeholder="Ketik namamu di sini..." value=""
                            class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-teal-600 focus:outline-none font-semibold text-slate-800 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                            <i class="fa-solid fa-id-card text-teal-600 mr-1"></i> No. Absen / NIS
                        </label>
                        <input id="playerAbsentInput" type="text" placeholder="Contoh: 12" value=""
                            class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-teal-600 focus:outline-none font-semibold text-slate-800 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                            <i class="fa-solid fa-graduation-cap text-orange-500 mr-1"></i> Kelas Kategori Siaga
                        </label>
                        <select id="playerClassInput" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-teal-600 focus:outline-none font-semibold text-slate-800 bg-white transition">
                            <option value="Kelas 4 ICP">Kelas 4 ICP</option>
                            <option value="Kelas 4 Reguler">Kelas 4 Reguler</option>
                            <option value="Kelas 5 ICP" selected>Kelas 5 ICP</option>
                            <option value="Kelas 5 Reguler">Kelas 5 Reguler</option>
                            <option value="Kelas 6 ICP">Kelas 6 ICP</option>
                            <option value="Kelas 6 Reguler">Kelas 6 Reguler</option>
                            <option value="Tim Olimpiade MUGEB">Tim Olimpiade MUGEB</option>
                        </select>
                    </div>
                </div>
                <div id="nameValidationAlert" class="hidden bg-rose-50 border border-rose-300 text-rose-800 px-4 py-2.5 rounded-xl text-xs font-bold flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation text-rose-600"></i>
                    <span>Silakan isi Nama Lengkap Siswa terlebih dahulu sebelum memulai permainan!</span>
                </div>

                <!-- Game Mode Filter -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">
                        <i class="fa-solid fa-layer-group text-teal-600 mr-1"></i> Pilih Paket Tantangan
                    </label>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <button onclick="selectMode('ALL')" id="mode_ALL" class="mode-btn p-4 rounded-2xl border-2 border-teal-600 bg-teal-50/70 text-left transition flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-center mb-1">
                                    <span class="font-game font-bold text-teal-900 text-lg">25 Soal Lengkap</span>
                                    <span class="bg-teal-600 text-white text-xs px-2 py-0.5 rounded-full font-bold">Rekomendasi</span>
                                </div>
                                <p class="text-xs text-slate-600">15 Soal Asli Bebras 2020 + 10 Soal Pengembangan Konsep Setara</p>
                            </div>
                            <div class="mt-3 text-xs font-bold text-teal-700">Skor Maks: 100 Poin (4 Poin/Soal)</div>
                        </button>

                        <button onclick="selectMode('ORIGINAL')" id="mode_ORIGINAL" class="mode-btn p-4 rounded-2xl border-2 border-slate-200 hover:border-teal-400 bg-white text-left transition flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-center mb-1">
                                    <span class="font-game font-bold text-slate-800 text-lg">15 Soal Asli Buku</span>
                                    <span class="bg-slate-200 text-slate-700 text-xs px-2 py-0.5 rounded-full font-bold">Original</span>
                                </div>
                                <p class="text-xs text-slate-600">Fokus ke 15 soal orisinal dari buku Tantangan Bebras Indonesia 2020</p>
                            </div>
                            <div class="mt-3 text-xs font-bold text-slate-500">Nomor 1 s.d. 15</div>
                        </button>

                        <button onclick="selectMode('EXPANSION')" id="mode_EXPANSION" class="mode-btn p-4 rounded-2xl border-2 border-slate-200 hover:border-teal-400 bg-white text-left transition flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-center mb-1">
                                    <span class="font-game font-bold text-slate-800 text-lg">10 Soal Tantangan+</span>
                                    <span class="bg-orange-100 text-orange-700 text-xs px-2 py-0.5 rounded-full font-bold">Pengembangan</span>
                                </div>
                                <p class="text-xs text-slate-600">10 soal baru dengan konsep komputasi yang sama untuk latihan ekstra</p>
                            </div>
                            <div class="mt-3 text-xs font-bold text-slate-500">Nomor 16 s.d. 25</div>
                        </button>
                    </div>
                </div>

                <!-- Start Button -->
                <div class="pt-2 flex flex-col sm:flex-row gap-3">
                    <button onclick="startGame()" class="btn-3d btn-orange flex-1 py-4 px-6 rounded-2xl text-white font-game font-bold text-xl tracking-wide flex items-center justify-center gap-3">
                        <i class="fa-solid fa-play"></i> MULAI PETUALANGAN SEKARANG!
                    </button>
                </div>
            </div>
        </section>

        <!-- ================= SCREEN 2: QUIZ / GAMEPLAY SCREEN ================= -->
        <section id="quizScreen" class="hidden space-y-4">
            <!-- Progress & Meta Header -->
            <div class="bg-white rounded-2xl p-4 shadow-md border border-slate-200">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                    <div class="flex items-center gap-2">
                        <span id="qNumberBadge" class="px-3 py-1 rounded-xl bg-teal-700 text-white font-game font-bold text-sm">
                            Soal 1 / 25
                        </span>
                        <span id="qSourceBadge" class="px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 font-bold text-xs">
                            2020-BE-03
                        </span>
                        <span id="qCategoryBadge" class="hidden sm:inline-block px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-semibold text-xs">
                            Pengenalan Pola
                        </span>
                    </div>
                    <div class="text-xs font-bold text-slate-500">
                        Dijawab: <span id="answeredCountText" class="text-teal-700">0</span>/<span id="totalCountText">25</span>
                    </div>
                </div>
                <!-- Progress Bar -->
                <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden p-0.5 border border-slate-200">
                    <div id="progressBar" class="h-full bg-gradient-to-r from-teal-500 to-amber-500 rounded-full transition-all duration-300" style="width: 4%"></div>
                </div>
            </div>

            <!-- Question Card -->
            <div class="bg-white rounded-3xl shadow-xl border-2 border-slate-200 overflow-hidden">
                <!-- Question Title Banner -->
                <div class="bg-slate-800 text-white px-6 py-4 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span id="qCountryFlag" class="text-2xl">🇧🇪</span>
                        <h2 id="qTitle" class="font-game text-xl sm:text-2xl font-bold tracking-wide">Manik-manik</h2>
                    </div>
                    <span class="text-xs px-2.5 py-1 rounded-full bg-white/15 font-semibold">Siaga SD</span>
                </div>

                <div class="p-5 sm:p-7 space-y-5">
                    <!-- Story & Visual Diagram -->
                    <div id="qStory" class="text-slate-700 text-sm sm:text-base leading-relaxed space-y-2"></div>

                    <!-- Dynamic SVG / Interactive Illustration Container -->
                    <div id="qVisualContainer" class="bg-slate-50 rounded-2xl p-4 border-2 border-dashed border-slate-200 flex justify-center items-center overflow-x-auto">
                    </div>

                    <!-- Challenge Prompt Box -->
                    <div class="bg-teal-50/80 border-l-4 border-teal-600 p-4 rounded-r-2xl">
                        <div class="text-xs font-extrabold uppercase tracking-wider text-teal-800 mb-1">
                            <i class="fa-solid fa-bullseye mr-1"></i> Tantangan:
                        </div>
                        <p id="qChallenge" class="font-bold text-slate-900 text-sm sm:text-base"></p>
                    </div>

                    <!-- Answer Options Grid -->
                    <div id="optionsContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
                    </div>

                    <!-- Discussion / Explanation Box (Appears after answering) -->
                    <div id="explanationBox" class="hidden rounded-2xl p-5 border-2 transition-all">
                        <div class="flex items-start gap-3">
                            <div id="expIconBox" class="w-10 h-10 rounded-xl flex items-center justify-center text-white font-bold text-lg flex-shrink-0 mt-0.5">
                                <i class="fa-solid fa-check"></i>
                            </div>
                            <div class="space-y-2 flex-1">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <h3 id="expHeading" class="font-game font-bold text-lg">Jawaban Tepat! (+4 Poin)</h3>
                                    <span id="expCorrectKey" class="text-xs font-extrabold px-2.5 py-1 rounded-lg bg-white/80 border">Kunci: C</span>
                                </div>
                                <div class="text-xs sm:text-sm font-semibold text-slate-600 bg-white/80 p-3.5 rounded-xl border border-slate-200/80 leading-relaxed space-y-1.5">
                                    <div class="font-bold text-teal-800 flex items-center gap-1.5">
                                        <i class="fa-solid fa-lightbulb text-amber-500"></i> Pembahasan & Konsep Informatika:
                                    </div>
                                    <div id="expText" class="text-slate-700"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Navigation Buttons -->
                    <div class="pt-3 border-t border-slate-200 flex items-center justify-between gap-3">
                        <button id="prevBtn" onclick="prevQuestion()" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm flex items-center gap-2 transition disabled:opacity-40">
                            <i class="fa-solid fa-arrow-left"></i> Sebelumnya
                        </button>

                        <button id="nextBtn" onclick="nextQuestion()" class="btn-3d btn-teal px-6 py-3 rounded-xl text-white font-game font-bold text-base flex items-center gap-2">
                            <span>Soal Berikutnya</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= SCREEN 3: FINAL RESULT & REVIEW SCREEN ================= -->
        <section id="resultScreen" class="hidden space-y-6">
            <div class="bg-white rounded-3xl shadow-xl border-2 border-teal-100 overflow-hidden">
                <div class="bg-gradient-to-br from-[#006778] to-[#004c59] p-6 sm:p-8 text-white text-center relative">
                    <!-- School Logo Badge on Certificate -->
                    <div class="inline-flex items-center gap-2 bg-white px-4 py-1.5 rounded-full shadow-md mb-4">
                        <span class="font-extrabold text-sm" style="color:#006778;">MUGEB</span>
                        <span class="font-bold italic text-xs" style="color:#EA7600;">Primary School</span>
                        <span class="text-slate-400">|</span>
                        <span class="font-semibold text-[11px] text-slate-700">SD Muhammadiyah GKB Gresik</span>
                    </div>

                    <h2 class="font-game text-3xl sm:text-4xl font-bold">Petualangan Selesai! 🎉</h2>
                    <p id="resultPlayerInfo" class="text-teal-100 mt-1 text-sm sm:text-base font-medium"></p>

                    <!-- Big Score Circle -->
                    <div class="my-6 inline-flex flex-col items-center justify-center w-36 h-36 sm:w-44 sm:h-44 rounded-full bg-white text-slate-800 shadow-2xl border-8 border-amber-400">
                        <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Skor Akhir</span>
                        <span id="finalScoreValue" class="font-game text-5xl sm:text-6xl font-bold text-teal-700">100</span>
                        <span id="finalMedalBadge" class="mt-1 px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 font-bold text-xs">Medali Emas</span>
                    </div>

                    <!-- Stats Grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl mx-auto">
                        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-3 border border-white/15">
                            <div class="text-2xl font-game font-bold text-emerald-300" id="statCorrect">0</div>
                            <div class="text-xs text-teal-100">Jawaban Benar</div>
                        </div>
                        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-3 border border-white/15">
                            <div class="text-2xl font-game font-bold text-rose-300" id="statWrong">0</div>
                            <div class="text-xs text-teal-100">Jawaban Salah</div>
                        </div>
                        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-3 border border-white/15">
                            <div class="text-2xl font-game font-bold text-amber-300" id="statBestStreak">0</div>
                            <div class="text-xs text-teal-100">Beruntun Terbaik</div>
                        </div>
