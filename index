        // ==================== KONFIGURASI GOOGLE SPREADSHEET & GITHUB ====================
        // GURU DAPAT MENEMPELKAN URL GOOGLE APPS SCRIPT WEB APP DI SINI SEBELUM DI-UPLOAD KE GITHUB:
        const DEFAULT_SCRIPT_URL = ""; 

        let customScriptUrl = DEFAULT_SCRIPT_URL;
        let recapHistory = []; // Menyimpan riwayat pengerjaan untuk tabel rekap & ekspor CSV
        let quizStartTime = null;
        let lastSubmittedPayload = null;

        function getActiveScriptUrl() {
            return (customScriptUrl || DEFAULT_SCRIPT_URL || "").trim();
        }

        function updateSheetIndicatorUI() {
            const url = getActiveScriptUrl();
            const indicator = document.getElementById('sheetConnectionIndicator');
            if (!indicator) return;
            if (url) {
                indicator.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-bold';
                indicator.innerHTML = '<i class="fa-solid fa-circle-check"></i> Spreadsheet Terhubung';
            } else {
                indicator.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 font-bold';
                indicator.innerHTML = '<i class="fa-solid fa-plug-circle-exclamation"></i> Mode Lokal (URL Spreadsheet Belum Diisi)';
            }
        }

        // ==================== GAME STATE VARIABLES ====================
        let selectedMode = 'ALL'; // 'ALL' (25), 'ORIGINAL' (15), 'EXPANSION' (10)
        let activeQuestions = [];
        let currentIndex = 0;
        let userAnswers = {}; // { questionIndex: selectedOptionIndex }
        let currentStreak = 0;
        let bestStreak = 0;

        // ==================== MODE SELECTION & INITIALIZATION ====================
        function selectMode(mode) {
            playTone('click');
            selectedMode = mode;
            ['ALL', 'ORIGINAL', 'EXPANSION'].forEach(m => {
                const btn = document.getElementById('mode_' + m);
                if (m === mode) {
                    btn.className = 'mode-btn p-4 rounded-2xl border-2 border-teal-600 bg-teal-50/70 text-left transition flex flex-col justify-between shadow-sm';
                } else {
                    btn.className = 'mode-btn p-4 rounded-2xl border-2 border-slate-200 hover:border-teal-400 bg-white text-left transition flex flex-col justify-between';
                }
            });
        }

        function startGame() {
            const nameInput = document.getElementById('playerNameInput');
            const alertBox = document.getElementById('nameValidationAlert');
            if (!nameInput.value.trim()) {
                alertBox.classList.remove('hidden');
                nameInput.focus();
                playTone('wrong');
                return;
            }
            alertBox.classList.add('hidden');

            playTone('click');
            if (selectedMode === 'ORIGINAL') {
                activeQuestions = ALL_QUESTIONS.filter(q => q.type === 'ORIGINAL');
            } else if (selectedMode === 'EXPANSION') {
                activeQuestions = ALL_QUESTIONS.filter(q => q.type === 'EXPANSION');
            } else {
                activeQuestions = [...ALL_QUESTIONS];
            }

            currentIndex = 0;
            userAnswers = {};
            currentStreak = 0;
            bestStreak = 0;
            quizStartTime = Date.now();

            document.getElementById('startScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.add('hidden');
            document.getElementById('quizScreen').classList.remove('hidden');

            document.getElementById('liveStats').classList.remove('hidden');
            document.getElementById('liveStats').classList.add('flex');
            document.getElementById('mapBtn').classList.remove('hidden');
            document.getElementById('mapBtn').classList.add('inline-flex');

            updateLiveHeader();
            renderCurrentQuestion();
        }

        function formatDuration(ms) {
            const totalSec = Math.max(1, Math.floor(ms / 1000));
            const mins = String(Math.floor(totalSec / 60)).padStart(2, '0');
            const secs = String(totalSec % 60).padStart(2, '0');
            return `${mins}:${secs}`;
        }

        function calculatePointsPerQuestion() {
            return Math.round((100 / activeQuestions.length) * 10) / 10;
        }

        function calculateCurrentScore() {
            let correctCount = 0;
            Object.keys(userAnswers).forEach(idx => {
                const q = activeQuestions[idx];
                if (q && userAnswers[idx] === q.correct) {
                    correctCount++;
                }
            });
            return Math.round((correctCount / activeQuestions.length) * 100);
        }

        function updateLiveHeader() {
            document.getElementById('headerScore').textContent = calculateCurrentScore();
            document.getElementById('headerStreak').textContent = currentStreak;
            document.getElementById('answeredCountText').textContent = Object.keys(userAnswers).length;
            document.getElementById('totalCountText').textContent = activeQuestions.length;
        }

        // ==================== RENDER QUESTION ====================
        function renderCurrentQuestion() {
            const q = activeQuestions[currentIndex];
            const total = activeQuestions.length;

            // Header Badges
            document.getElementById('qNumberBadge').textContent = `Soal ${currentIndex + 1} / ${total}`;
            document.getElementById('qSourceBadge').textContent = q.code;
            document.getElementById('qCategoryBadge').textContent = q.category;
            document.getElementById('qCountryFlag').textContent = q.flag;
            document.getElementById('qTitle').textContent = q.title;

            // Progress Bar
            const pct = Math.round(((currentIndex + 1) / total) * 100);
            document.getElementById('progressBar').style.width = `${pct}%`;

            // Story, Visual & Challenge
            document.getElementById('qStory').innerHTML = q.story;
            document.getElementById('qVisualContainer').innerHTML = q.visual;
            document.getElementById('qChallenge').textContent = q.challenge;

            // Render Options
            const optionsContainer = document.getElementById('optionsContainer');
            optionsContainer.innerHTML = '';

            const hasAnswered = userAnswers.hasOwnProperty(currentIndex);
            const selectedOpt = userAnswers[currentIndex];

            q.options.forEach((optText, optIdx) => {
                const btn = document.createElement('button');
                btn.disabled = hasAnswered;

                let baseStyle = 'option-card p-4 rounded-2xl border-2 text-left font-semibold text-sm sm:text-base flex items-center justify-between gap-3 ';
                let iconHTML = `<span class="w-7 h-7 rounded-full bg-slate-100 border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-600 flex-shrink-0">${String.fromCharCode(65 + optIdx)}</span>`;

                if (!hasAnswered) {
                    baseStyle += 'bg-white border-slate-200 hover:border-teal-500 hover:bg-teal-50/40 text-slate-800 shadow-sm';
                } else {
                    if (optIdx === q.correct) {
                        baseStyle += 'bg-emerald-50 border-emerald-500 text-emerald-950 shadow-sm';
                        iconHTML = `<span class="w-7 h-7 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs flex-shrink-0"><i class="fa-solid fa-check"></i></span>`;
                    } else if (optIdx === selectedOpt && optIdx !== q.correct) {
                        baseStyle += 'bg-rose-50 border-rose-500 text-rose-950';
                        iconHTML = `<span class="w-7 h-7 rounded-full bg-rose-500 text-white flex items-center justify-center text-xs flex-shrink-0"><i class="fa-solid fa-xmark"></i></span>`;
                    } else {
                        baseStyle += 'bg-slate-50 border-slate-200 text-slate-400 opacity-75';
                    }
                }

                btn.className = baseStyle;
                btn.innerHTML = `<span>${optText}</span>${iconHTML}`;
                btn.onclick = () => selectAnswer(optIdx);
                optionsContainer.appendChild(btn);
            });

            // Explanation Box
            const expBox = document.getElementById('explanationBox');
            if (hasAnswered) {
                const isCorrect = selectedOpt === q.correct;
                expBox.classList.remove('hidden');
                if (isCorrect) {
                    expBox.className = 'rounded-2xl p-5 border-2 bg-emerald-50/70 border-emerald-300 transition-all';
                    document.getElementById('expIconBox').className = 'w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white font-bold text-lg flex-shrink-0 mt-0.5';
                    document.getElementById('expIconBox').innerHTML = '<i class="fa-solid fa-check"></i>';
                    document.getElementById('expHeading').className = 'font-game font-bold text-lg text-emerald-900';
                    document.getElementById('expHeading').textContent = `Hebat! Jawabanmu Benar (+${calculatePointsPerQuestion()} Poin)`;
                } else {
                    expBox.className = 'rounded-2xl p-5 border-2 bg-rose-50/70 border-rose-300 transition-all';
                    document.getElementById('expIconBox').className = 'w-10 h-10 rounded-xl bg-rose-600 flex items-center justify-center text-white font-bold text-lg flex-shrink-0 mt-0.5';
                    document.getElementById('expIconBox').innerHTML = '<i class="fa-solid fa-xmark"></i>';
                    document.getElementById('expHeading').className = 'font-game font-bold text-lg text-rose-900';
                    document.getElementById('expHeading').textContent = 'Kurang Tepat! Yuk Simak Pembahasannya';
                }
                document.getElementById('expCorrectKey').textContent = `Kunci Jawaban: ${String.fromCharCode(65 + q.correct)}`;
                document.getElementById('expText').innerHTML = q.explanation;
            } else {
                expBox.classList.add('hidden');
            }

            // Bottom Navigation Buttons
            document.getElementById('prevBtn').disabled = currentIndex === 0;
            const nextBtn = document.getElementById('nextBtn');
            if (currentIndex === total - 1) {
                nextBtn.innerHTML = `<span>Lihat Hasil Akhir</span> <i class="fa-solid fa-flag-checkered"></i>`;
                nextBtn.className = 'btn-3d btn-orange px-6 py-3 rounded-xl text-white font-game font-bold text-base flex items-center gap-2';
            } else {
                nextBtn.innerHTML = `<span>Soal Berikutnya</span> <i class="fa-solid fa-arrow-right"></i>`;
                nextBtn.className = 'btn-3d btn-teal px-6 py-3 rounded-xl text-white font-game font-bold text-base flex items-center gap-2';
            }
        }

        function selectAnswer(optIdx) {
            if (userAnswers.hasOwnProperty(currentIndex)) return;
            userAnswers[currentIndex] = optIdx;

            const q = activeQuestions[currentIndex];
            if (optIdx === q.correct) {
                currentStreak++;
                if (currentStreak > bestStreak) bestStreak = currentStreak;
                playTone('correct');
            } else {
                currentStreak = 0;
                playTone('wrong');
            }

            updateLiveHeader();
            renderCurrentQuestion();
        }

        function prevQuestion() {
            if (currentIndex > 0) {
                playTone('click');
                currentIndex--;
                renderCurrentQuestion();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function nextQuestion() {
            playTone('click');
            if (currentIndex < activeQuestions.length - 1) {
                currentIndex++;
                renderCurrentQuestion();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                showFinalResults();
            }
        }

        // ==================== QUESTION MAP MODAL ====================
        function openQuestionMap() {
            playTone('click');
            const grid = document.getElementById('mapGridContainer');
            grid.innerHTML = '';

            activeQuestions.forEach((q, idx) => {
                const btn = document.createElement('button');
                let style = 'h-11 rounded-xl font-game font-bold text-sm border-2 transition flex items-center justify-center ';

                if (userAnswers.hasOwnProperty(idx)) {
                    if (userAnswers[idx] === q.correct) {
                        style += 'bg-emerald-500 text-white border-emerald-600';
                    } else {
                        style += 'bg-rose-500 text-white border-rose-600';
                    }
                } else {
                    style += 'bg-slate-100 text-slate-700 border-slate-200 hover:border-teal-500';
                }

                if (idx === currentIndex) {
                    style += ' ring-4 ring-amber-400';
                }

                btn.className = style;
                btn.textContent = idx + 1;
                btn.onclick = () => {
                    currentIndex = idx;
                    closeQuestionMap();
                    renderCurrentQuestion();
                };
                grid.appendChild(btn);
            });

            const modal = document.getElementById('questionMapModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeQuestionMap() {
            const modal = document.getElementById('questionMapModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function finishQuizNow() {
            closeQuestionMap();
            showFinalResults();
        }

        // ==================== FINAL RESULTS & REVIEW ====================
        function showFinalResults() {
            playTone('correct');
            document.getElementById('quizScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.remove('hidden');
            document.getElementById('mapBtn').classList.add('hidden');

            const playerName = document.getElementById('playerNameInput').value.trim() || 'Juara MUGEB';
            const playerAbsent = document.getElementById('playerAbsentInput').value.trim() || '-';
            const playerClass = document.getElementById('playerClassInput').value;
            const durationText = quizStartTime ? formatDuration(Date.now() - quizStartTime) : '00:00';

            document.getElementById('resultPlayerInfo').textContent = `${playerName} (Absen: ${playerAbsent}) • ${playerClass}`;

            let correctCount = 0;
            let wrongCount = 0;
            let answerDetails = [];

            activeQuestions.forEach((q, idx) => {
                const ansIdx = userAnswers[idx];
                const ansChar = ansIdx !== undefined ? String.fromCharCode(65 + ansIdx) : '-';
                const isRight = ansIdx === q.correct;
                if (isRight) {
                    correctCount++;
                } else {
                    wrongCount++;
                }
                answerDetails.push(`No.${q.id}:${ansChar}(${isRight ? 'B' : 'S'})`);
            });

            const finalScore = Math.round((correctCount / activeQuestions.length) * 100);
            document.getElementById('finalScoreValue').textContent = finalScore;
            document.getElementById('statCorrect').textContent = correctCount;
            document.getElementById('statWrong').textContent = wrongCount;
            document.getElementById('statBestStreak').textContent = bestStreak;
            document.getElementById('statDuration').textContent = durationText;

            const medalBadge = document.getElementById('finalMedalBadge');
            if (finalScore >= 85) {
                medalBadge.textContent = '🏆 Medali Emas Bebras MUGEB';
                medalBadge.className = 'mt-1 px-3 py-0.5 rounded-full bg-amber-100 text-amber-800 font-bold text-xs';
            } else if (finalScore >= 70) {
                medalBadge.textContent = '🥈 Medali Perak Bebras MUGEB';
                medalBadge.className = 'mt-1 px-3 py-0.5 rounded-full bg-slate-200 text-slate-800 font-bold text-xs';
            } else {
                medalBadge.textContent = '🥉 Semangat Berlatih Lagi!';
                medalBadge.className = 'mt-1 px-3 py-0.5 rounded-full bg-orange-100 text-orange-800 font-bold text-xs';
            }

            // Prepare Payload & Send to Google Spreadsheet
            const modeLabel = selectedMode === 'ALL' ? '25 Soal Lengkap' : (selectedMode === 'ORIGINAL' ? '15 Soal Asli' : '10 Soal Pengembangan');
            const payload = {
                waktu: new Date().toLocaleString('id-ID'),
                nama: playerName,
                absen: playerAbsent,
                kelas: playerClass,
                paket: modeLabel,
                skor: finalScore,
                benar: correctCount,
                salah: wrongCount,
                streak: bestStreak,
                durasi: durationText,
                detailJawaban: answerDetails.join(', '),
                cloudSynced: false
            };

            lastSubmittedPayload = payload;
            recapHistory.unshift(payload);
            submitScoreToSpreadsheet(payload);

            // Populate Complete Review List
            const reviewContainer = document.getElementById('reviewListContainer');
            reviewContainer.innerHTML = '';

            activeQuestions.forEach((q, idx) => {
                const userAns = userAnswers[idx];
                const isCorrect = userAns === q.correct;
                const statusBadge = isCorrect
                    ? `<span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs"><i class="fa-solid fa-check mr-1"></i>Benar</span>`
                    : `<span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800 font-bold text-xs"><i class="fa-solid fa-xmark mr-1"></i>${userAns === undefined ? 'Belum Dijawab' : 'Salah'}</span>`;

                const card = document.createElement('div');
                card.className = 'p-4 rounded-2xl border border-slate-200 bg-slate-50/70 space-y-2';
                card.innerHTML = `
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="font-bold text-slate-800 text-sm sm:text-base">
                            <span class="text-teal-700">#${idx + 1}</span> ${q.flag} ${q.title}
                            <span class="text-xs font-normal text-slate-500 ml-1">(${q.code})</span>
                        </div>
                        ${statusBadge}
                    </div>
                    <p class="text-xs sm:text-sm font-semibold text-slate-700">${q.challenge}</p>
                    <div class="text-xs space-y-1 bg-white p-3 rounded-xl border border-slate-200">
                        <div><strong>Jawabanmu:</strong> <span class="${isCorrect ? 'text-emerald-700 font-bold' : 'text-rose-600 font-bold'}">${userAns !== undefined ? q.options[userAns] : 'Tidak dijawab'}</span></div>
                        <div><strong>Kunci Jawaban:</strong> <span class="text-teal-700 font-bold">${q.options[q.correct]}</span></div>
                        <div class="pt-1 text-slate-600 border-t border-slate-100 mt-1"><strong>Pembahasan:</strong> ${q.explanation}</div>
                    </div>
                `;
                reviewContainer.appendChild(card);
            });

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ==================== GOOGLE SPREADSHEET INTEGRATION & EXPORT ====================
        async function submitScoreToSpreadsheet(payload) {
            const statusBox = document.getElementById('sheetSyncStatusBox');
            const retryBtn = document.getElementById('retrySyncBtn');
            const scriptUrl = getActiveScriptUrl();

            if (!scriptUrl) {
                statusBox.className = 'mt-5 max-w-xl mx-auto px-4 py-2.5 rounded-2xl bg-amber-400/20 border border-amber-300/40 text-amber-100 text-xs sm:text-sm font-semibold flex items-center justify-center gap-2';
                statusBox.innerHTML = `<i class="fa-solid fa-table"></i> <span>Tersimpan di Tabel Rekap Aplikasi. <button onclick="openTeacherModal()" class="underline font-bold text-white ml-1">Klik di sini untuk menghubungkan Google Spreadsheet</button></span>`;
                retryBtn.classList.add('hidden');
                return;
            }

            statusBox.className = 'mt-5 max-w-xl mx-auto px-4 py-2.5 rounded-2xl bg-white/15 border border-white/20 text-white text-xs sm:text-sm font-semibold flex items-center justify-center gap-2';
            statusBox.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Mengirim rekap nilai ke Google Spreadsheet...</span>`;
            retryBtn.classList.add('hidden');

            try {
                await fetch(scriptUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });
                payload.cloudSynced = true;
                statusBox.className = 'mt-5 max-w-xl mx-auto px-4 py-2.5 rounded-2xl bg-emerald-500/30 border border-emerald-300/50 text-emerald-50 text-xs sm:text-sm font-bold flex items-center justify-center gap-2';
                statusBox.innerHTML = `<i class="fa-solid fa-cloud-check text-emerald-300"></i> <span>Berhasil! Nilai & rincian jawaban telah terekap di Google Spreadsheet.</span>`;
            } catch (err) {
                statusBox.className = 'mt-5 max-w-xl mx-auto px-4 py-2.5 rounded-2xl bg-rose-500/30 border border-rose-300/50 text-rose-100 text-xs sm:text-sm font-bold flex items-center justify-center gap-2';
                statusBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> <span>Gagal mengirim ke Spreadsheet. Periksa koneksi internet atau URL Script.</span>`;
                retryBtn.classList.remove('hidden');
                retryBtn.classList.add('inline-flex');
            }
        }

        function manualResendToSheet() {
            if (lastSubmittedPayload) {
                submitScoreToSpreadsheet(lastSubmittedPayload);
            }
        }

        function openLeaderboardModal() {
            playTone('click');
            updateSheetIndicatorUI();
            renderRecapTable();
            const modal = document.getElementById('leaderboardModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeLeaderboardModal() {
            const modal = document.getElementById('leaderboardModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function renderRecapTable() {
            const tbody = document.getElementById('recapTableBody');
            tbody.innerHTML = '';

            if (recapHistory.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="10" class="p-8 text-center text-slate-400 font-semibold">
                            Belum ada data pengerjaan pada sesi ini. Silakan mainkan kuis atau klik "Muat dari Spreadsheet".
                        </td>
                    </tr>
                `;
                return;
            }

            recapHistory.forEach((row, i) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 transition';
                const syncBadge = row.cloudSynced
                    ? `<span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[11px]">Terkirim</span>`
                    : `<span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-semibold text-[11px]">Lokal</span>`;

                tr.innerHTML = `
                    <td class="p-3 font-bold text-slate-500">${i + 1}</td>
                    <td class="p-3 text-slate-600 whitespace-nowrap">${row.waktu || '-'}</td>
                    <td class="p-3 font-bold text-slate-800">${row.nama || '-'}</td>
                    <td class="p-3 text-slate-600">${row.absen || '-'}</td>
                    <td class="p-3 text-slate-600">${row.kelas || '-'}</td>
                    <td class="p-3 text-slate-600">${row.paket || '-'}</td>
                    <td class="p-3 text-center font-semibold"><span class="text-emerald-600">${row.benar}B</span> / <span class="text-rose-600">${row.salah}S</span></td>
                    <td class="p-3 text-center font-mono text-slate-600">${row.durasi || '-'}</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-lg bg-teal-100 text-teal-900 font-game font-bold">${row.skor}</span></td>
                    <td class="p-3 text-center">${syncBadge}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        async function fetchCloudRecap() {
            const scriptUrl = getActiveScriptUrl();
            if (!scriptUrl) {
                openTeacherModal();
                return;
            }
            playTone('click');
            try {
                const res = await fetch(scriptUrl);
                const json = await res.json();
                if (json && Array.isArray(json.data)) {
                    recapHistory = json.data.reverse().map(item => ({
                        waktu: new Date(item.waktu).toLocaleString('id-ID'),
                        nama: item.nama,
                        absen: item.absen,
                        kelas: item.kelas,
                        paket: item.paket,
                        skor: item.skor,
                        benar: item.benar,
                        salah: item.salah,
                        streak: item.streak,
                        durasi: item.durasi,
                        cloudSynced: true
                    }));
                    renderRecapTable();
                }
            } catch (e) {
                console.warn('Fetch spreadsheet error:', e);
            }
        }

        function exportRecapToCSV() {
            playTone('click');
            if (recapHistory.length === 0) return;

            const headers = ['No', 'Waktu Submit', 'Nama Siswa', 'No Absen', 'Kelas', 'Paket Soal', 'Skor Akhir', 'Benar', 'Salah', 'Streak Terbaik', 'Durasi', 'Detail Jawaban'];
            const csvRows = [headers.join(',')];

            recapHistory.forEach((r, idx) => {
                const row = [
                    idx + 1,
                    `"${(r.waktu || '').replace(/"/g, '""')}"`,
                    `"${(r.nama || '').replace(/"/g, '""')}"`,
                    `"${(r.absen || '').replace(/"/g, '""')}"`,
                    `"${(r.kelas || '').replace(/"/g, '""')}"`,
                    `"${(r.paket || '').replace(/"/g, '""')}"`,
                    r.skor || 0,
                    r.benar || 0,
                    r.salah || 0,
                    r.streak || 0,
                    `"${r.durasi || '-'}"`,
                    `"${(r.detailJawaban || '-').replace(/"/g, '""')}"`
                ];
                csvRows.push(row.join(','));
            });

            const csvBlob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(csvBlob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Rekap_Nilai_MUGEB_Bebras_${new Date().toISOString().slice(0,10)}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // ==================== TEACHER SETTINGS MODAL ====================
        function openTeacherModal() {
            playTone('click');
            document.getElementById('scriptUrlInput').value = getActiveScriptUrl();
            document.getElementById('scriptUrlSaveFeedback').classList.add('hidden');
            const modal = document.getElementById('teacherModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeTeacherModal() {
            const modal = document.getElementById('teacherModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveScriptUrl() {
            playTone('correct');
            customScriptUrl = document.getElementById('scriptUrlInput').value.trim();
            updateSheetIndicatorUI();
            const fb = document.getElementById('scriptUrlSaveFeedback');
            fb.textContent = customScriptUrl
                ? '✅ URL Google Apps Script berhasil disimpan! Setiap pengerjaan siswa akan otomatis dikirim ke Spreadsheet.'
                : '⚠️ URL dikosongkan. Aplikasi berjalan dalam mode penyimpanan tabel lokal.';
            fb.classList.remove('hidden');
        }

        async function testScriptConnection() {
            saveScriptUrl();
            const url = getActiveScriptUrl();
            const fb = document.getElementById('scriptUrlSaveFeedback');
            if (!url) {
                fb.textContent = '❌ Masukkan URL Web App terlebih dahulu sebelum melakukan tes kirim.';
                fb.classList.remove('hidden');
                return;
            }
            fb.textContent = '⏳ Mengirim baris uji coba ke Google Spreadsheet...';
            fb.classList.remove('hidden');

            const samplePayload = {
                waktu: new Date().toLocaleString('id-ID'),
                nama: 'Uji Coba Koneksi Guru',
                absen: '00',
                kelas: 'Tim Olimpiade MUGEB',
                paket: 'Tes Integrasi Spreadsheet',
                skor: 100,
                benar: 25,
                salah: 0,
                streak: 25,
                durasi: '01:20',
                detailJawaban: 'Tes Koneksi Berhasil'
            };

            try {
                await fetch(url, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(samplePayload)
                });
                fb.textContent = '✅ Data uji coba berhasil dikirim! Silakan cek tab sheet "RekapNilai" pada Google Spreadsheet Anda.';
            } catch (err) {
                fb.textContent = '❌ Gagal menghubungi URL tersebut. Pastikan URL berakhiran /exec dan akses disetel ke "Anyone" (Siapa saja).';
            }
        }

        function copyAppsScriptCode() {
            const codeArea = document.getElementById('appsScriptCodeArea');
            codeArea.select();
            document.execCommand('copy');
            const btnText = document.getElementById('copyBtnText');
            btnText.textContent = 'Tersalin!';
            playTone('correct');
            setTimeout(() => {
                btnText.textContent = 'Salin Kode Apps Script';
            }, 2000);
        }

        function restartSameMode() {
            startGame();
        }

        function returnToMenu() {
            playTone('click');
            document.getElementById('quizScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.add('hidden');
            document.getElementById('startScreen').classList.remove('hidden');
            document.getElementById('liveStats').classList.add('hidden');
            document.getElementById('mapBtn').classList.add('hidden');
        }

        function confirmReturnHome() {
            returnToMenu();
        }
    </script>
</body>
